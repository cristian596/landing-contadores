{
  "name": "plantilla-contadores",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web para firma de contabilidad y asesoría financiera (Astro, estático).",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "astro": "^7.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
