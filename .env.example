# Copia este archivo como .env y reemplaza los valores. Ninguno es secreto: todos terminan en el HTML público.

# Dominio definitivo del sitio (canonical, sitemap, Open Graph).
PUBLIC_SITE_URL=https://www.ejemplo.com

# ID de medición de Google Analytics 4. Solo se carga si el visitante acepta las cookies de analítica.
PUBLIC_GA_ID=G-XXXXXXX

# Endpoint del servicio de formularios (p. ej. https://formspree.io/f/xxxxxxx).
# Si queda vacío, el formulario muestra un error en lugar de fingir el envío.
PUBLIC_FORM_ENDPOINT=
