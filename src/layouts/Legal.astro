---
import Base from './Base.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  toc?: { id: string; label: string }[];
}
const { title, description, toc = [] } = Astro.props;
---

<Base title={title} description={description}>
  <article class="legal wrap section" aria-labelledby="page-title">
    <header class="legal-head">
      <h1 id="page-title" class="legal-title">
        {title}
      </h1>
      <p class="lead">{description}</p>
      <p class="muted">Última actualización: {site.legalUpdated}</p>
      <p class="notice small">
        Texto de referencia preparado como plantilla. Debe revisarlo un asesor legal y completarse con los
        datos reales de {site.legalName} antes de publicar.
      </p>
    </header>

    <div class="legal-body">
      {toc.length > 0 && (
        <nav class="toc" aria-label="Contenido de esta página">
          <h2 class="toc-title small">En esta página</h2>
          <ol class="toc-list">
            {toc.map((item) => (
              <li>
                <a class="link" href={`#${item.id}`}>
                  {item.label}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <div class="prose">
        <slot />
      </div>
      {Astro.slots.has('aside') && (
        <div class="legal-aside">
          <slot name="aside" />
        </div>
      )}
    </div>
  </article>
</Base>

<style>
  .legal-head {
    display: grid;
    gap: 0.75rem;
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .legal-title {
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    max-width: 16ch;
  }
  .notice {
    max-width: 60ch;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 22%, var(--bg));
  }
  .legal-body {
    display: grid;
    gap: 2.5rem;
  }
  .toc {
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--surface);
    align-self: start;
  }
  .toc-title {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .toc-list {
    display: grid;
    gap: 0.15rem;
    padding-left: 1.25rem;
  }
  .toc-list a {
    display: inline-block;
    padding-block: 0.4rem;
  }
  .prose {
    min-width: 0;
    max-width: 46rem;
  }
  .prose :global(h2) {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 3rem 0 1rem;
    scroll-margin-top: 2rem;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.75rem 0 0.5rem;
  }
  .prose :global(p),
  .prose :global(li) {
    max-width: 68ch;
    overflow-wrap: anywhere;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0.75rem 0 1rem;
    padding-left: 1.4rem;
    display: grid;
    gap: 0.4rem;
  }
  .prose :global(p + p) {
    margin-top: 0.9em;
  }
  .prose :global(p + ul),
  .prose :global(p + ol) {
    margin-top: 0.75rem;
  }
  .prose :global(ul + p),
  .prose :global(ol + p) {
    margin-top: 0.9em;
  }
  .prose :global(table) {
    width: 100%;
    margin: 1rem 0 1.5rem;
    border-collapse: collapse;
    font-size: var(--step-small);
  }
  .prose :global(.table-wrap) {
    overflow-x: auto;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.75rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--surface-strong);
  }
  .prose :global(th) {
    font-weight: 600;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (min-width: 64em) {
    .legal-body:has(.toc) {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--gutter);
    }
    .legal-body:has(.legal-aside) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--gutter);
    }
    .legal-aside {
      position: sticky;
      top: 2rem;
      align-self: start;
    }
    .toc {
      position: sticky;
      top: 2rem;
    }
  }
</style>
