---
import { Picture } from 'astro:assets';
import { photos, type PhotoKey } from '../data/photos';

const thumbs: { key: PhotoKey; word: string }[] = [
  { key: 'calculadoraFacturas', word: 'facturas' },
  { key: 'reunionMesa', word: 'nómina' },
  { key: 'formulariosImpuestos', word: 'declaración de renta' },
];

const rows: { title: string; text: string; photo: PhotoKey; shape: 'tall' | 'wide' | 'square' }[] = [
  {
    title: 'Un honorario fijo',
    text: 'Sabes desde el primer mes cuánto pagas. No cobramos por hora ni por cada llamada; lo que esté fuera del plan se cotiza antes.',
    photo: 'independienteEscritorio',
    shape: 'tall',
  },
  {
    title: 'Fechas bajo control',
    text: 'Te avisamos antes de cada vencimiento según el último dígito de tu NIT, con los soportes listos para revisar y firmar.',
    photo: 'revisionDocumentos',
    shape: 'wide',
  },
  {
    title: 'Un contador para ti',
    text: 'Siempre hablas con la misma persona, que sabe cómo facturas, qué gastos deduces y qué te preocupa.',
    photo: 'contadorRevisa',
    shape: 'square',
  },
  {
    title: 'Reportes que se entienden',
    text: 'Cada cierre trae un resumen en lenguaje claro: cuánto ganaste, cuánto reservar para impuestos y qué cambió.',
    photo: 'colegasRevision',
    shape: 'tall',
  },
];
---

<section class="benefits wrap section" aria-labelledby="benefits-title">
  <p class="statement" data-reveal>
    <span class="statement-main">
      Tus{' '}
      <span class="thumb">
        <Picture
          src={photos[thumbs[0]!.key].src}
          alt=""
          formats={['avif', 'webp']}
          widths={[240, 480]}
          sizes="(min-width: 64em) 22rem, 7rem"
          loading="lazy"
        />
      </span>{' '}
      facturas, tu{' '}
      <span class="thumb">
        <Picture
          src={photos[thumbs[1]!.key].src}
          alt=""
          formats={['avif', 'webp']}
          widths={[240, 480]}
          sizes="(min-width: 64em) 22rem, 7rem"
          loading="lazy"
        />
      </span>{' '}
      nómina y tu{' '}
      <span class="nowrap">
        <span class="thumb">
          <Picture
            src={photos[thumbs[2]!.key].src}
            alt=""
            formats={['avif', 'webp']}
            widths={[240, 480]}
            sizes="(min-width: 64em) 22rem, 7rem"
            loading="lazy"
          />
        </span>{' '}
        declaración de renta,
      </span>
    </span>{' '}
    <span class="statement-sub">con contadores que conocen el trabajo independiente.</span>
  </p>

  <div class="axis">
    <h2 id="benefits-title" class="head benefits-title" data-reveal>
      Lo que ganas
    </h2>

    <ul class="rows">
      {rows.map((row) => (
        <li class="row">
          <div class="row-text" data-reveal>
            <h3 class="row-title">{row.title}</h3>
            <p>{row.text}</p>
          </div>
          <div class:list={['row-photo', `row-photo--${row.shape}`]} data-reveal data-delay="1">
            <Picture
              src={photos[row.photo].src}
              alt={photos[row.photo].alt}
              formats={['avif', 'webp']}
              widths={[360, 640, 960]}
              sizes="(min-width: 64em) 22vw, 90vw"
              loading="lazy"
            />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .benefits {
    padding-block: clamp(2.5rem, 5vw, 5rem);
  }
  .statement {
    max-width: none;
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-align: left;
  }
  .statement-main {
    display: block;
    font-size: clamp(2.25rem, 1.2rem + 4.6vw, 4.5rem);
    text-wrap: pretty;
  }
  .statement-sub {
    display: block;
    margin-top: 1.25rem;
    font-size: var(--step-lead);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--muted);
  }
  .thumb {
    display: inline-block;
    width: 2.2em;
    height: 0.72em;
    vertical-align: baseline;
    border-radius: 0.14em;
    overflow: hidden;
    background: var(--surface);
  }
  .thumb :global(picture),
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .axis {
    margin-top: clamp(3rem, 6vw, 5.5rem);
  }
  .benefits-title {
    max-width: 10ch;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .rows {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  .row {
    display: grid;
    gap: 1.25rem;
  }
  .row-title {
    font-size: var(--step-sub);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }
  .row-text p {
    max-width: 32ch;
  }
  .row-photo {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .row-photo :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .row-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row-photo--tall {
    aspect-ratio: 4 / 5;
  }
  .row-photo--wide {
    aspect-ratio: 3 / 2;
  }
  .row-photo--square {
    aspect-ratio: 1;
  }

  @media (min-width: 48em) {
    .nowrap {
      white-space: nowrap;
    }
    .statement-main {
      font-size: clamp(2.25rem, calc((100vw - 2 * var(--margin)) / 12.6), 12rem);
    }
    .statement-sub {
      width: calc(50% - var(--gutter) / 2);
      margin-top: 2rem;
      margin-left: auto;
      font-size: var(--step-sub);
    }
  }

  @media (min-width: 64em) {
    /* Título a la izquierda (sticky); cada fila es una tarjeta foto + texto en las columnas 5-12. */
    .axis {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .benefits-title {
      grid-column: 1 / 5;
      align-self: start;
      position: sticky;
      top: 2rem;
    }
    .rows {
      grid-column: 5 / 13;
    }
    .row {
      --photo: 46fr;
      --text: 54fr;
      grid-template-columns: minmax(0, var(--text)) minmax(0, var(--photo));
      column-gap: clamp(1.5rem, 3vw, 3.5rem);
      align-items: center;
    }
    .row:has(.row-photo--tall) {
      --photo: 42fr;
      --text: 58fr;
    }
    .row:has(.row-photo--wide) {
      --photo: 56fr;
      --text: 44fr;
    }
    /* Las filas impares llevan la foto a la izquierda, solo en lo visual; el DOM no cambia. */
    .row:nth-child(odd) {
      grid-template-columns: minmax(0, var(--photo)) minmax(0, var(--text));
    }
    .row:nth-child(odd) .row-photo {
      order: -1;
    }
    /* El texto se arrima a su foto, no al borde de la tarjeta. */
    .row .row-text {
      justify-self: end;
      text-align: left;
    }
    .row:nth-child(odd) .row-text {
      justify-self: start;
    }
    .row-text p {
      font-size: var(--step-lead);
      line-height: 1.4;
    }
  }
</style>
