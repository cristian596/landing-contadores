---
import type { Faq } from '../data/faq';

interface Props {
  items: Faq[];
  name: string;
}
const { items, name } = Astro.props;
---

{items.length === 0 ? (
  <p class="faq-empty">Aún no hay preguntas en esta categoría.</p>
) : (
  <div class="faq-list">
    {items.map((item, i) => (
      <details class="faq" name={name} data-reveal data-delay={String(Math.min(i + 1, 4))}>
        <summary class="faq-q">
          <span dir="auto">{item.q}</span>
          <svg
            class="chevron"
            width="20"
            height="20"
            viewBox="0 0 20 20"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="m5 8 5 5 5-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </summary>
        <div class="faq-a">
          <p dir="auto">{item.a}</p>
        </div>
      </details>
    ))}
  </div>
)}

<style>
  .faq-list {
    display: grid;
    gap: 0.5rem;
  }
  .faq {
    border-radius: var(--radius);
    transition: background-color var(--t-ui) var(--ease-out);
    interpolate-size: allow-keywords;
  }
  .faq[open] {
    background: var(--surface);
  }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 56px;
    padding: 1rem 1.5rem;
    list-style: none;
    cursor: pointer;
    font-size: var(--step-lead);
    line-height: 1.3;
    letter-spacing: -0.01em;
    border-radius: var(--radius);
    overflow-wrap: anywhere;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .chevron {
    flex: none;
    transition: rotate var(--t-ui) var(--ease-out);
  }
  .faq[open] .chevron {
    rotate: 180deg;
  }
  .faq-a {
    padding: 0 1.5rem 1.5rem;
  }
  .faq-a p {
    max-width: 52ch;
    overflow-wrap: anywhere;
  }
  /* Apertura animada en altura donde el navegador lo permite; en los demás se abre al instante. */
  @media (prefers-reduced-motion: no-preference) {
    .faq::details-content {
      height: 0;
      overflow: clip;
      transition:
        height var(--t-ui) var(--ease-out),
        content-visibility var(--t-ui) allow-discrete;
    }
    .faq[open]::details-content {
      height: auto;
    }
    .faq-a {
      opacity: 0;
      translate: 0 -6px;
      transition:
        opacity var(--t-hover) var(--ease-out) 60ms,
        translate var(--t-ui) var(--ease-out);
    }
    .faq[open] .faq-a {
      opacity: 1;
      translate: 0;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .faq:not([open]) .faq-q:hover {
      background: var(--surface);
    }
  }
  .faq-empty {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--surface);
  }
</style>
