---
import { LIMITS, SERVICE_OPTIONS } from '../lib/form';
import Icon from './Icon.astro';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
---

<form
  class="contact-form"
  method="post"
  action={endpoint || undefined}
  data-contact-form
  data-endpoint={endpoint || ''}
  aria-describedby="form-status"
>
  <div class="field">
    <label for="cf-name">Nombre completo</label>
    <input
      id="cf-name"
      name="name"
      type="text"
      autocomplete="name"
      required
      minlength="2"
      maxlength={LIMITS.name}
      aria-describedby="cf-name-error"
      enterkeyhint="next"
    />
    <p class="error" id="cf-name-error" data-error-for="name"></p>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="cf-email">Correo electrónico</label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        autocapitalize="none"
        spellcheck="false"
        required
        maxlength={LIMITS.email}
        aria-describedby="cf-email-error"
        enterkeyhint="next"
      />
      <p class="error" id="cf-email-error" data-error-for="email"></p>
    </div>
    <div class="field">
      <label for="cf-phone">
        Teléfono <span class="optional">(opcional)</span>
      </label>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        maxlength={LIMITS.phone}
        aria-describedby="cf-phone-error"
        enterkeyhint="next"
      />
      <p class="error" id="cf-phone-error" data-error-for="phone"></p>
    </div>
  </div>

  <div class="field">
    <label for="cf-service">Servicio de interés</label>
    <div class="select-wrap">
      <select id="cf-service" name="service" required aria-describedby="cf-service-error">
        <option value="">Elige una opción</option>
        {SERVICE_OPTIONS.map((s) => (
          <option value={s}>{s}</option>
        ))}
      </select>
    </div>
    <p class="error" id="cf-service-error" data-error-for="service"></p>
  </div>

  <div class="field">
    <label for="cf-message">Mensaje</label>
    <textarea
      id="cf-message"
      name="message"
      rows="5"
      required
      minlength="10"
      maxlength={LIMITS.message}
      aria-describedby="cf-message-hint cf-message-error"
      enterkeyhint="send"
    ></textarea>
    <p class="hint small" id="cf-message-hint">
      Cuéntanos a qué te dedicas y qué necesitas resolver.
    </p>
    <p class="error" id="cf-message-error" data-error-for="message"></p>
  </div>

  <!-- Trampa para bots: oculta a personas y lectores de pantalla. -->
  <div class="hp" aria-hidden="true">
    <label for="cf-website">No llenes este campo</label>
    <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="plan" value="" data-plan-field />

  <div class="field consent">
    <div class="consent-row">
      <input
        id="cf-consent"
        name="consent"
        type="checkbox"
        value="si"
        required
        aria-describedby="cf-consent-error"
      />
      <!-- prettier-ignore -->
      <label for="cf-consent">Acepto el tratamiento de mis datos personales conforme a la <a class="link" href="/tratamiento-de-datos" target="_blank" rel="noopener">Política de tratamiento de datos</a>.</label>
    </div>
    <p class="error" id="cf-consent-error" data-error-for="consent"></p>
  </div>

  <button class="button button--ink submit" type="submit" data-submit>
    <span data-submit-label>Enviar mensaje</span>
    <Icon name="arrow" size={18} class="arrow" />
  </button>

  <div id="form-status" class="status" role="status" aria-live="polite" data-status></div>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.25rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }
  .field-row {
    display: grid;
    gap: 1.25rem;
  }
  label {
    font-weight: 500;
  }
  .optional {
    font-weight: 400;
    color: var(--muted);
  }
  input[type='text'],
  input[type='email'],
  input[type='tel'],
  select,
  textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    border: 2px solid transparent;
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font-size: max(16px, 1rem);
    transition:
      border-color var(--t-hover) ease,
      background-color var(--t-hover) ease;
  }
  textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .select-wrap {
    position: relative;
  }
  .select-wrap::after {
    content: '';
    position: absolute;
    right: 1.1rem;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  select {
    appearance: none;
    padding-right: 2.75rem;
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--ink);
    background: var(--bg);
  }
  [aria-invalid='true'] {
    border-color: var(--danger) !important;
  }
  @media (prefers-reduced-motion: no-preference) {
    .error,
    .status {
      transition:
        opacity 200ms var(--ease-out),
        translate 200ms var(--ease-out);
      @starting-style {
        opacity: 0;
        translate: 0 -4px;
      }
    }
  }
  .error {
    min-height: 0;
    color: var(--danger);
    font-size: var(--step-small);
    font-weight: 500;
  }
  .error:empty {
    display: none;
  }
  .hint {
    color: var(--muted);
  }
  .consent-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .consent-row label {
    font-weight: 400;
    line-height: 1.45;
  }
  .consent-row input {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    accent-color: var(--ink);
  }
  .hp {
    position: absolute;
    width: 1px;
    height: 1px; /* taste-skill-ignore: campo trampa oculto, no es una línea */
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .submit {
    justify-self: start;
    min-height: 3.5rem;
    padding-inline: 1.75rem;
  }
  .submit[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }
  .status:empty {
    display: none;
  }
  .status {
    padding: 1rem 1.25rem;
    border-radius: 10px;
    font-weight: 500;
  }
  .status[data-kind='success'] {
    background: color-mix(in srgb, var(--success) 14%, var(--bg));
    color: var(--success);
  }
  .status[data-kind='error'] {
    background: color-mix(in srgb, var(--danger) 10%, var(--bg));
    color: var(--danger);
  }
  @media (min-width: 40em) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 39.99em) {
    .submit {
      justify-self: stretch;
    }
  }
</style>

<script>
  import { isSpam, validateContact, type ContactErrors, type ContactInput } from '../lib/form';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    form.noValidate = true;
    const endpoint = form.dataset.endpoint ?? '';
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const planField = form.querySelector<HTMLInputElement>('[data-plan-field]')!;

    // Si llega desde una tarjeta de plan (?plan=...), se anota el plan y se sugiere un mensaje.
    const plan = new URLSearchParams(location.search).get('plan');
    const planNames: Record<string, string> = {
      basico: 'Básico',
      profesional: 'Profesional',
      empresarial: 'Empresarial',
    };
    if (plan && planNames[plan]) {
      planField.value = planNames[plan];
      const message = form.elements.namedItem('message') as HTMLTextAreaElement;
      if (!message.value) message.value = `Me interesa el plan ${planNames[plan]}. `;
    }

    const read = (): ContactInput => {
      const data = new FormData(form);
      return {
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        phone: String(data.get('phone') ?? ''),
        service: String(data.get('service') ?? ''),
        message: String(data.get('message') ?? ''),
        consent: data.get('consent') === 'si',
        website: String(data.get('website') ?? ''),
      };
    };

    const showErrors = (errors: ContactErrors) => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        const key = el.dataset.errorFor as keyof ContactErrors;
        el.textContent = errors[key] ?? '';
        const input = form.elements.namedItem(key) as HTMLElement | null;
        if (input) input.setAttribute('aria-invalid', errors[key] ? 'true' : 'false');
      });
    };

    const setStatus = (kind: 'success' | 'error' | '', text: string) => {
      status.dataset.kind = kind;
      status.textContent = text;
    };

    // Revalida un campo al salir de él solo si ya mostraba un error.
    form.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.getAttribute('aria-invalid') !== 'true') return;
      const errors = validateContact(read());
      const key = target.name as keyof ContactErrors;
      const el = form.querySelector<HTMLElement>(`[data-error-for="${key}"]`);
      if (el) el.textContent = errors[key] ?? '';
      target.setAttribute('aria-invalid', errors[key] ? 'true' : 'false');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const input = read();
      const errors = validateContact(input);
      showErrors(errors);
      const firstInvalid = Object.keys(errors)[0];
      if (firstInvalid) {
        setStatus('error', 'Revisa los campos marcados antes de enviar.');
        (form.elements.namedItem(firstInvalid) as HTMLElement | null)?.focus();
        return;
      }
      if (isSpam(input)) {
        setStatus('success', 'Gracias, recibimos tu mensaje.');
        form.reset();
        return;
      }
      if (!endpoint) {
        setStatus(
          'error',
          'El formulario aún no está conectado a un servicio de envío. Escríbenos por correo mientras tanto.',
        );
        return;
      }

      submit.setAttribute('aria-busy', 'true');
      submitLabel.textContent = 'Enviando…';
      setStatus('', '');
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            nombre: input.name.trim(),
            correo: input.email.trim(),
            telefono: input.phone.trim(),
            servicio: input.service,
            plan: planField.value,
            mensaje: input.message.trim(),
            autoriza_tratamiento_datos: true,
            fecha_autorizacion: new Date().toISOString(),
          }),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        showErrors({});
        setStatus('success', 'Gracias, recibimos tu mensaje. Te responderemos en un día hábil.');
      } catch {
        setStatus('error', 'No pudimos enviar el mensaje. Inténtalo de nuevo o escríbenos por correo.');
      } finally {
        submit.removeAttribute('aria-busy');
        submitLabel.textContent = 'Enviar mensaje';
      }
    });
  }
</script>
