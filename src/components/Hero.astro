---
import { Picture } from 'astro:assets';
import { photos } from '../data/photos';
import Icon from './Icon.astro';
---

<section class="hero grid wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="hero-badge">Contabilidad especializada para independientes en Colombia</p>
    <h1 id="hero-title" class="hero-title display">
      Contabilidad sin sobresaltos
    </h1>
    <p class="lead hero-sub">
      Llevamos la contabilidad, los impuestos y la nómina de contadores y consultores independientes con un
      honorario fijo cada mes.
    </p>
    <div class="hero-actions">
      <a class="button hero-primary" href="/contacto">
        Agenda una consulta <Icon name="arrow" size={18} class="arrow" />
      </a>
      <a class="link hero-secondary" href="/planes">
        Ver planes y precios
      </a>
    </div>
  </div>

  <div class="hero-photo">
    <div class="hero-frame">
      <Picture
        src={photos.salaReuniones.src}
        alt={photos.salaReuniones.alt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 64em) 48vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-img"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    row-gap: clamp(2rem, 5vw, 3rem);
    align-content: center;
    padding-block: 2rem clamp(2rem, 6vh, 4rem);
  }
  .hero-copy {
    grid-column: 1 / -1;
    display: grid;
    justify-items: start;
    align-content: center;
  }
  .hero-badge {
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
    padding: 0.4rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--step-small);
    font-weight: 500;
    line-height: 1.4;
  }
  .hero-title {
    font-size: clamp(2.75rem, 1.5rem + 4.6vw, 6.25rem);
    font-weight: 500;
  }
  .hero-sub {
    max-width: 46ch;
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }
  .hero-primary {
    min-height: 3rem;
  }
  .hero-secondary {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 500;
  }

  /* La sombra va en el contenedor exterior: el clip-path animado del interior la recortaría. */
  .hero-photo {
    grid-column: 1 / -1;
    border-radius: var(--radius);
    box-shadow: 0 24px 60px rgb(15 36 64 / 0.12); /* taste-skill-ignore: foto del hero */
  }
  .hero-frame {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .hero-frame :global(picture) {
    display: block;
  }
  .hero-frame :global(picture),
  .hero-frame :global(img) {
    width: 100%;
    height: 100%;
  }
  .hero-frame :global(img) {
    object-fit: cover;
    object-position: 35% 60%;
  }

  @media (max-width: 29.999em) {
    .hero-actions {
      display: grid;
      width: 100%;
      justify-items: stretch;
      gap: 0.75rem;
    }
    .hero-secondary {
      justify-content: center;
    }
  }

  @media (min-width: 64em) {
    .hero {
      align-items: center;
      padding-block: clamp(2.5rem, 6vh, 4rem);
      column-gap: clamp(2rem, 4vw, 4rem);
    }
    .hero-copy {
      grid-column: 1 / 8;
    }
    /* La foto llena el ancho de su columna; el alto se limita a min(78svh, 46rem). */
    .hero-photo {
      grid-column: 8 / -1;
    }
    .hero-frame {
      aspect-ratio: 4 / 5;
      max-height: min(78svh, 46rem);
    }
  }

  @media (min-width: 90em) {
    .hero {
      min-height: calc(100svh - 5rem);
    }
    .hero-copy {
      grid-column: 1 / 7;
    }
    .hero-photo {
      grid-column: 7 / -1;
    }
    .hero-frame {
      aspect-ratio: 7 / 5;
    }
    .hero-frame :global(img) {
      object-position: 40% 70%;
    }
  }

  /* Pantallas muy anchas: el texto cabe en 5 columnas y la foto toma 7, con la proporción original (3/2). */
  @media (min-width: 112em) {
    .hero-copy {
      grid-column: 1 / 6;
    }
    .hero-photo {
      grid-column: 6 / -1;
    }
    .hero-frame {
      aspect-ratio: 3 / 2;
    }
  }

  /* El movimiento firma del sitio: la foto se abre como un obturador y se asienta. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-badge,
    .hero-title,
    .hero-sub,
    .hero-actions {
      animation: rise 900ms var(--ease-out) both;
    }
    .hero-title {
      animation-delay: 120ms;
    }
    .hero-sub {
      animation-delay: 240ms;
    }
    .hero-actions {
      animation-delay: 360ms;
    }
    .hero-frame {
      animation: shutter 1100ms var(--ease-in-out) 200ms both;
    }
    .hero-frame :global(img) {
      animation: settle 1500ms var(--ease-soft) 200ms both;
    }
  }
  @keyframes shutter {
    from {
      clip-path: inset(0 100% 0 0 round var(--radius));
    }
    to {
      clip-path: inset(0 0 0 0 round var(--radius));
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.12);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
