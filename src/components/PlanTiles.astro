---
import { plans as defaultPlans, yearlyDiscount, type Plan } from '../data/plans';

interface Props {
  headingLevel?: 'h1' | 'h2';
  title?: string;
  items?: Plan[];
}
const { headingLevel = 'h2', title = 'Planes que crecen contigo', items = defaultPlans } = Astro.props;
const Heading = headingLevel;
---

<section class="plans wrap section" aria-labelledby="plans-title" data-plans>
  <div class="plans-head">
    <Heading id="plans-title" class="head plans-title" data-reveal>
      {title}
    </Heading>
    <p class="plans-note lead" data-reveal data-delay="1">
      Tres planes de contabilidad con honorario fijo mensual para independientes. Precios en pesos
      colombianos, antes de IVA.
    </p>
    <fieldset class="billing" data-reveal data-delay="2">
      <legend class="sr-only">Forma de pago</legend>
      <label class="billing-option">
        <input type="radio" name="billing" value="monthly" checked />
        <span>Mensual</span>
      </label>
      <label class="billing-option">
        <input type="radio" name="billing" value="yearly" />
        <span>Anual · ahorra {yearlyDiscount}</span>
      </label>
    </fieldset>
  </div>

  <ol class="tiles">
    {items.map((plan, i) => (
      <li
        class:list={['tile', `tile--${plan.id}`]}
        data-plan={plan.id}
        data-reveal
        data-delay={String(i + 1)}
      >
        <div class="tile-body">
          <p class="tile-flag small" aria-hidden="true">
            Recomendado para ti
          </p>
          <h3 class="tile-name" dir="auto">
            {plan.name}
          </h3>
          <p class="tile-for" dir="auto">
            {plan.forWhom}
          </p>
          <p class="tile-price nums">
            <span class="price-monthly">
              {plan.monthly}
              <span class="unit">COP / mes</span>
            </span>
            <span class="price-yearly">
              {plan.yearly}
              <span class="unit">COP / año</span>
            </span>
          </p>
          <ul class="tile-list">
            {plan.highlights.map((h) => (
              <li dir="auto">{h}</li>
            ))}
          </ul>
        </div>
        <a class="tile-action" href={`/contacto?plan=${plan.id}`}>
          <span class="action-label">Elegir {plan.name}</span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .plans-head {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    margin-bottom: 2.5rem;
  }
  .plans-title {
    max-width: 10ch;
  }
  .billing {
    display: inline-flex;
    gap: 0.25rem;
    margin: 0.5rem 0 0;
    padding: 0.25rem;
    border: 0;
    border-radius: 999px;
    background: var(--surface);
  }
  .billing-option {
    position: relative;
    cursor: pointer;
  }
  .billing-option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .billing-option span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: 999px;
    font-weight: 500;
    transition:
      background-color var(--t-ui) var(--ease-out),
      color var(--t-ui) var(--ease-out);
  }
  .billing-option input:checked + span {
    background: var(--ink);
    color: var(--on-field);
  }
  .billing-option input:focus-visible + span {
    outline: 3px solid var(--accent-strong);
    outline-offset: 2px;
  }
  .price-monthly,
  .price-yearly {
    display: inline-block;
  }
  .price-yearly {
    display: none;
  }
  .plans:has(input[value='yearly']:checked) .price-yearly {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .price-monthly,
    .price-yearly {
      transition:
        opacity 200ms var(--ease-out),
        translate 200ms var(--ease-out);
      @starting-style {
        opacity: 0;
        translate: 0 6px;
      }
    }
  }
  .plans:has(input[value='yearly']:checked) .price-monthly {
    display: none;
  }

  .tiles {
    display: grid;
    gap: 8px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    overflow: hidden;
    outline: 3px solid transparent;
    outline-offset: 12px;
    transition:
      translate var(--t-ui) var(--ease-out),
      outline-offset var(--t-ui) var(--ease-out),
      outline-color var(--t-ui) ease;
  }
  .tile--basico {
    background: var(--surface);
    --strip: var(--surface-strong);
  }
  .tile--profesional {
    background: var(--accent);
    color: var(--accent-ink);
    --strip: var(--accent-strong);
  }
  .tile--empresarial {
    background: var(--field);
    color: var(--on-field);
    --strip: var(--field-deep);
  }
  .tile-body {
    flex: 1;
    padding: 1.75rem;
  }
  .tile-flag {
    display: none;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }
  .tile[data-recommended] .tile-flag {
    display: block;
  }
  .tile-name {
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .tile-for {
    margin-top: 0.35rem;
    max-width: 30ch;
  }
  .tile-price {
    margin-top: 1.5rem;
    font-size: var(--step-sub);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
  }
  .unit {
    display: block;
    margin-top: 0.4rem;
    font-size: var(--step-small);
    letter-spacing: 0;
    font-weight: 400;
  }
  .tile-list {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .tile-list li::before {
    content: '';
    flex: none;
    width: 0.7em;
    height: 0.4em;
    margin-top: 0.45em;
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: -45deg;
  }
  .tile-list li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .action-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .tile-action .arrow {
    flex-shrink: 0;
  }
  .tile-name,
  .tile-for,
  .tile-list li {
    overflow-wrap: anywhere;
  }
  .tile-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
    padding: 0.75rem 1.75rem;
    background: var(--strip);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--t-hover) ease;
  }
  .tile-action .arrow {
    transition: transform var(--t-ui) var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tile-action:active .arrow {
      transform: translateX(4px);
    }
  }
  .tile[data-recommended] {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  .tile--empresarial[data-recommended] {
    outline-color: var(--accent-strong);
  }

  @media (min-width: 64em) {
    /* Los planes suben como barras: el más completo es literalmente el más alto. */
    .plans {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
      column-gap: 8px;
      align-items: end;
    }
    .plans-head {
      grid-column: 1 / 3;
      grid-row: 1;
      align-self: start;
      margin: 0;
    }
    .tiles {
      display: contents;
    }
    .tile {
      grid-row: 2;
    }
    .tile--basico {
      grid-column: 1;
      min-height: 400px;
    }
    .tile--profesional {
      grid-column: 2;
      min-height: 520px;
    }
    .tile--empresarial {
      grid-column: 3;
      grid-row: 1 / 3;
      min-height: 660px;
    }
    .plans-head {
      padding-bottom: 2.5rem;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover {
      translate: 0 -4px;
    }
    .tile-action:hover {
      filter: brightness(0.96);
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .tile-action:hover .arrow {
      transform: translateX(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile:hover {
      translate: none;
    }
  }
</style>
